# 仅用于首次启动时创建 admin 所有者账号；创建后密码存储在 data/admin-users.json
# 正式环境首次部署前必须修改
ADMIN_PASSWORD=change-this-password

# 仅本地演示测试时设置为 1；正式环境不要开启
DEMO_AUTO_PAY=0

# 主观题 AI 评分；正式密钥只写入服务器环境文件，不提交 Git
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=20000

# 可选，默认 3000
PORT=3000
# 正式部署仅监听本机，由 Nginx / ESA 接入
HOST=127.0.0.1
# 部署时填写 Git 提交号，供 /api/health 验证版本
RELEASE_REVISION=development

# Native 支付（独立文考商户号；不要填写点单系统商户的密钥）
ONBOARDING_EXAM_PUBLIC_URL=https://exam.example.com
ONBOARDING_EXAM_WECHAT_PAY_MCH_ID=
ONBOARDING_EXAM_WECHAT_PAY_APP_ID=
ONBOARDING_EXAM_WECHAT_PAY_API_V3_KEY=
ONBOARDING_EXAM_WECHAT_PAY_MCH_SERIAL_NO=
ONBOARDING_EXAM_WECHAT_PAY_PRIVATE_KEY_BASE64=
ONBOARDING_EXAM_WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
ONBOARDING_EXAM_WECHAT_PAY_PLATFORM_PUBLIC_KEY_BASE64=
